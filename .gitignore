# Patient imaging can contain identifiers. Keep the folders, never the pixels.
# Explicit rules for organized inboxes and files commonly shipped with DICOM exports.
data/raw/*/inbox/**
data/raw/**/DICOMDIR
data/raw/**/LICENSE
data/raw/**
data/sorted/**
data/masks/**

!data/raw/
!data/raw/**/
!data/raw/**/.gitkeep

!data/sorted/
!data/sorted/**/
!data/sorted/**/.gitkeep

!data/masks/
!data/masks/**/
!data/masks/**/.gitkeep

# Derived, pseudonymized feature tables may be versioned; model run artifacts stay local.
outputs/**

*.dcm
*.DCM
*.dicom
*.nii
*.nii.gz
*.nrrd

.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store
